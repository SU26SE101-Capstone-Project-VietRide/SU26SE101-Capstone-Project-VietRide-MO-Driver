{
  "expo": {
    "name": "VietRide Driver",
    "slug": "vietride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vietride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "online.vietride.driver",
      "associatedDomains": [
        "applinks:vietride.online"
      ]
    },
    "android": {
      "package": "online.vietride.driver",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2AC1BC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vietride.online",
              "pathPrefix": "/auth/set-password"
            },
            {
              "scheme": "https",
              "host": "vietride.online",
              "pathPrefix": "/driver/parcel-approval"
            },
            {
              "scheme": "https",
              "host": "vietride.online",
              "pathPrefix": "/parcel-stop-departure-approvals"
            },
            {
              "scheme": "https",
              "host": "vietride.online",
              "pathPrefix": "/crew/parcel-stop-departure-approvals"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2AC1BC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VietRide Driver dùng vị trí để cập nhật hành trình chuyến xe cho hành khách theo dõi khi bạn đang chạy."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "VietRide Driver dùng camera để quét mã QR trên vé của hành khách khi đón khách lên xe.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "./plugins/with-android-assets.js",
      "@rnmapbox/maps",
      [
        "@badatgil/expo-mapbox-navigation",
        {
          "mapboxMapsVersion": "11.11.0",
          "androidColorOverrides": {
            "mapbox_main_maneuver_background_color": "#0F1F1B",
            "mapbox_primary_maneuver_text_color": "#FFFFFF",
            "mapbox_secondary_maneuver_text_color": "#9FB8B2",
            "mapbox_step_distance_text_color": "#02C39A",
            "mapbox_turn_icon_color": "#02C39A",
            "mapbox_turn_icon_shadow_color": "#0F1F1B",
            "mapbox_sub_maneuver_background_color": "#16302A",
            "mapbox_sub_maneuver_text_color": "#DDE7E4",
            "mapbox_upcoming_maneuver_background_color": "#16302A",
            "mapbox_trip_progress_view_background_color": "#0F1F1B",
            "mapbox_trip_progress_text_color": "#FFFFFF",
            "mapbox_trip_progress_divider_color": "#2A403A",
            "mapbox_status_view_background": "#0F1F1B",
            "mapbox_status_view_foreground": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
